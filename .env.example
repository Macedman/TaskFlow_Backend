# Copy to .env for local development, or enter these in the host's settings (Render).
# Never commit real values: .env is git-ignored, this file holds names only.

# Port the server listens on. Render sets this itself.
PORT=

# Production (Neon): the full connection string from Neon's dashboard, including ?sslmode=require.
# When set, it is used instead of the DB_* settings below. Leave it empty locally.
DATABASE_URL=

# Local development (and tests, which always use the taskflow_test database).
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# Signs login tokens. At least 32 random characters; the server will not start without it.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use a different one in production than locally.
JWT_SECRET=

# The frontend's address(es) allowed to call the API, comma-separated. Defaults to http://localhost:4300.
CORS_ORIGIN=

# Set to 1 behind Render's proxy, so rate limits see each visitor's real address. Leave empty locally.
TRUST_PROXY=

# Optional: total size of all stored PDFs, in MB (default 100).
ATTACHMENT_STORAGE_LIMIT_MB=
